# --- Resound configuration -------------------------------------------------
# Copy to .env and fill in what you need. Everything here is optional except
# what the feature you are using requires. Resound is local-first; with no env
# set at all it runs in mock mode and writes portable files to ./transcripts.

# Where session folders are written.
RESOUND_OUTPUT_DIR=./transcripts

# Transcription provider (local-first):
#   mock              no setup, deterministic (tests/dev)
#   local-whisper     RECOMMENDED — runs locally, audio never leaves the machine
#   openai-compatible optional remote expansion for ANY OpenAI-compatible API
#   openai            shorthand for openai-compatible against api.openai.com
#   deepgram | assemblyai   scaffolded (not implemented yet)
RESOUND_TRANSCRIBER=local-whisper

# Optional model override for the selected provider.
RESOUND_TRANSCRIBER_MODEL=

# --- local-whisper (local-first) ------------------------------------------
# Default expects whisper.cpp's `whisper-cli` on PATH. Point at whatever you have.
RESOUND_WHISPER_COMMAND=whisper-cli
# Output dialect: whisper.cpp | openai-whisper
RESOUND_WHISPER_FORMAT=whisper.cpp
# Model name or ggml model path (e.g. ./models/ggml-base.en.bin)
RESOUND_WHISPER_MODEL=
# Extra raw args appended before the audio file (optional)
RESOUND_WHISPER_ARGS=

# --- openai-compatible (optional remote expansion) -------------------------
# Works with any OpenAI-compatible /audio/transcriptions endpoint: a local
# whisper.cpp server, LM Studio, vLLM, Groq, OpenRouter, OpenAI itself, etc.
RESOUND_OPENAI_BASE_URL=
# Key for the endpoint (many local servers accept any/empty token).
RESOUND_OPENAI_API_KEY=
# Legacy alias also accepted:
OPENAI_API_KEY=

# (scaffolded, not yet implemented)
DEEPGRAM_API_KEY=
ASSEMBLYAI_API_KEY=

# --- Discord bot -----------------------------------------------------------
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: register slash commands to a single guild for fast iteration.
DISCORD_GUILD_ID=
# Bot mode:
#   mock           consent-aware sample sessions + artifacts, no voice/audio capture
#   local-capture  slash commands control this Mac's system/mic recorder
#   discord        join the caller's voice channel and capture live through the Pycord sidecar (default)
#   auto           preflight discord first, then explicit fallback to local-capture
# Preferred live receiver backend:
#   pycord         use the Python/Pycord sidecar receiver (default)
#   auto           try Pycord first, then legacy @discordjs/voice
#   discordjs      force the legacy Node receive stack
RESOUND_BOT_MODE=discord
RESOUND_DISCORD_RECEIVER_BACKEND=pycord
RESOUND_DISCORD_PYTHON=python3

# --- local-capture / `resound record` audio devices ------------------------
# Run `pnpm cli devices` and set either:
#   RESOUND_AUDIO_DEVICE=<single input>
# or:
#   RESOUND_AUDIO_SYSTEM_DEVICE=<BlackHole/system audio input>
#   RESOUND_AUDIO_MIC_DEVICE=<your microphone input>
RESOUND_AUDIO_DEVICE=
RESOUND_AUDIO_SYSTEM_DEVICE=
RESOUND_AUDIO_MIC_DEVICE=

# --- Strata sink (optional) ------------------------------------------------
# Command used to push a Markdown transcript into Strata. The session's
# transcript.md path is appended as the final argument.
STRATA_INGEST_COMMAND=strata notes add --file
