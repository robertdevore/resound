# ─────────────────────────────────────────────────────────────────────────
# Secrets & credentials — NEVER commit these
# ─────────────────────────────────────────────────────────────────────────
# Env files (the committed template .env.example is explicitly allowed below)
.env
.env.*
!.env.example
*.env

# Package-manager auth (npmrc/yarnrc can hold registry _authToken values)
.npmrc
.yarnrc
.yarnrc.yml

# Keys, certificates, tokens, service-account files
*.pem
*.key
*.pkcs12
*.p12
*.pfx
*.cer
*.crt
*.der
id_rsa*
id_ed25519*
*.keystore
*.jks
secrets.json
secrets.yaml
secrets.yml
credentials.json
*credentials*.json
gha-creds-*.json
service-account*.json
.netrc

# ─────────────────────────────────────────────────────────────────────────
# Recorded audio & transcripts — may contain private meeting content
# ─────────────────────────────────────────────────────────────────────────
# Generated session output (keep the folder, ignore its contents)
transcripts/**
!transcripts/.gitkeep

# Stray recordings anywhere in the tree
*.wav
*.aiff
*.aif
*.m4a
*.mp3
*.flac
*.ogg
*.opus
*.webm
*.aac

# Local whisper.cpp / ggml model weights (large binaries, not source)
models/
*.bin
*.gguf
*.ggml
*.mlmodelc/

# ─────────────────────────────────────────────────────────────────────────
# Node / pnpm / TypeScript
# ─────────────────────────────────────────────────────────────────────────
node_modules/
.pnpm-store/
.pnpm-debug.log*
dist/
build/
out/
*.tsbuildinfo
.tsbuildinfo
coverage/
.nyc_output/
.vitest/
.turbo/
.cache/
.eslintcache

# Logs & debug output
*.log
logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Runtime / temp
*.pid
*.seed
*.pid.lock
tmp/
temp/
.tmp/

# ─────────────────────────────────────────────────────────────────────────
# OS & editor cruft
# ─────────────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
Desktop.ini

.idea/
.vscode/*
!.vscode/extensions.json
!.vscode/settings.shared.json
*.swp
*.swo
*~
.history/
