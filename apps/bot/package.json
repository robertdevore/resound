{
  "name": "@resound/bot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo",
    "start": "node dist/index.js",
    "register": "node dist/register.js"
  },
  "dependencies": {
    "@resound/audio": "workspace:*",
    "@resound/core": "workspace:*",
    "@resound/exporters": "workspace:*",
    "@resound/sinks": "workspace:*",
    "@resound/transcribers": "workspace:*",
    "discord.js": "^14.16.3"
  },
  "optionalDependencies": {
    "@discordjs/voice": "^0.19.0",
    "@discordjs/opus": "^0.10.0",
    "prism-media": "^1.3.5",
    "libsodium-wrappers": "^0.7.15"
  }
}
